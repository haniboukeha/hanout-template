# ============================================================
# HANOUT Frontend - Environment Variables
# ============================================================

# API base URL.
# Dev (backend running on :4000 via Vite proxy): /api
# Production (Vercel): the deployed backend URL, e.g. https://hanout-api.vercel.app/api
VITE_API_URL=/api

# Backend URL for the Vite dev proxy (dev only)
VITE_BACKEND_URL=http://localhost:4000

# Offline demo mode with mock data + mock auth.
# NEVER set this to true in production.
VITE_ALLOW_MOCK=false

# Cloudinary (product image uploads). Create an UNSIGNED upload preset
# in Cloudinary Dashboard > Upload Settings, then fill these in.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: Analytics
# VITE_GA_ID=G-XXXXXXXX
