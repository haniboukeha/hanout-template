# Backend API URL - for local development
# If backend is running on port 4000, this will be proxied via Vite
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:4000

# Or use full URL for production backend
# VITE_API_URL=https://api.hanout.dz/api

# Optional: Analytics
# VITE_GA_ID=G-XXXXXXXX

# App version (auto-injected)
# __APP_VERSION__ is defined via vite.config.ts
