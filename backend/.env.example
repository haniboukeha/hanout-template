# Neon Postgres connection string (use the POOLED (-pooler. / port 6000) URL in production)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# REQUIRED in production - generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

PORT=4000
NODE_ENV=development

# Comma-separated allowed frontend origins (production: your Vercel URL)
CORS_ORIGINS="http://localhost:5173"

# Seed admin bootstrap (ADMIN_PASSWORD is REQUIRED when NODE_ENV=production)
ADMIN_EMAIL="admin@hanout.dz"
ADMIN_PASSWORD=""
